# PostgreSQL Database Provisioning & Credentials Example
# Copy this file to .env and configure local development credentials.
# The real .env is gitignored and must never be committed.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=minicloud
POSTGRES_PORT=5433

# Database Connection URLs (Host is 127.0.0.1:5433)
MINICLOUD_DATABASE_URL=postgres://postgres:replace_with_strong_password@127.0.0.1:5433/minicloud?sslmode=disable
MINICLOUD_TEST_DATABASE_URL=postgres://postgres:replace_with_strong_password@127.0.0.1:5433/minicloud_test?sslmode=disable
