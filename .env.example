# PostgreSQL Database Provisioning & Credentials Example
# Copy this file to .env and configure local development credentials.
# The real .env is gitignored and must never be committed.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=minicloud
POSTGRES_PORT=5433

# Database Connection URLs (Host is 127.0.0.1:5433)
MINICLOUD_DATABASE_URL=postgres://postgres:replace_with_strong_password@127.0.0.1:5433/minicloud?sslmode=disable
MINICLOUD_TEST_DATABASE_URL=postgres://postgres:replace_with_strong_password@127.0.0.1:5433/minicloud_test?sslmode=disable

# Coordinator Configuration (optional; defaults shown from internal/config/config.go)
# MINICLOUD_HTTP_ADDR=127.0.0.1:8080
# MINICLOUD_STORAGE_DRIVER=memory
# MINICLOUD_DATABASE_URL=""
# MINICLOUD_LOG_LEVEL=info
# MINICLOUD_HEARTBEAT_INTERVAL=2s
# MINICLOUD_WORKER_TIMEOUT=10s
# MINICLOUD_REAPER_INTERVAL=5s
# MINICLOUD_DEFAULT_MAX_ATTEMPTS=3
# MINICLOUD_MAX_JOB_RUNTIME=60s
# MINICLOUD_DB_MAX_CONNS=20
# MINICLOUD_DB_MIN_CONNS=2
# MINICLOUD_DB_QUERY_TIMEOUT=5s
# MINICLOUD_LEASE_DURATION=30s
# MINICLOUD_SWEEPER_INTERVAL=5s
# MINICLOUD_STARTUP_GRACE_PERIOD=30s
# MINICLOUD_OUTAGE_GRACE_WINDOW=30s
# MINICLOUD_DISPATCH_POLICY=round_robin
# MINICLOUD_ASSIGNMENT_ACCEPT_WINDOW=5s
# MINICLOUD_ASSIGNMENT_INTERVAL=1s
# MINICLOUD_ASSIGNMENT_MAX_LAPSES=3
# MINICLOUD_ASSIGNMENT_FALLBACK_AGE=30s
# MINICLOUD_ASSIGNMENT_BATCH_LIMIT=50
# MINICLOUD_ASSIGNMENT_MIN_YIELD=10ms
